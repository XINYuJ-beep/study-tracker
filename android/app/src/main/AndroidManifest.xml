<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 通知权限：Android 13+ (API 33) 必须显式声明并运行时申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 开机自启：重启后重建 WorkManager 周期任务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- 精确闹钟：WorkManager 定时任务在部分 ROM 上需要 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- 通知震动与唤醒 -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:label="学习打卡"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <!-- 不要在这里手动声明 androidx.work.impl.background.systemalarm.RescheduleReceiver：
             work-runtime 自带的 AndroidManifest 已经声明了它（enabled 默认 false，由库运行时按需开关）。
             手动再写一份 enabled="true" 会让 manifest merger 直接构建失败：
             Attribute receiver#...RescheduleReceiver@enabled value=(true) is also present at
             [androidx.work:work-runtime:2.11.2] value=(false)。
             重启后恢复周期任务靠上面的 RECEIVE_BOOT_COMPLETED 权限 + 库自身声明，无需手写。 -->
        <!-- 2026-10-30 已删除 io.flutter.embedding.android.ImpellerBackend=opengles。
             原因：Flutter 3.29+ 引擎只识别 io.flutter.embedding.android.EnableImpeller，
             ImpellerBackend 在 3.47 引擎里不再被读取，且其历史合法取值只有 vulkan/opengles，
             显式指定 opengles 会走 GLES 回退路径，在部分 Adreno 驱动上首帧永不提交。
             现交由引擎默认策略（运行期自动在 Vulkan / GLES 之间回退）自行决策。 -->
        <!-- 2026-10-30 fix2：设备端 logcat 实锤 SurfaceFlinger 每 8ms 抛
             "gatherBufferInfo: Received unknown dataspace from gralloc"，
             且 Adreno 抛 "Unknown Format 0"，说明 Impeller(Vulkan) 提交的
             buffer 描述符失效，SF 拒绝合成 → 首帧永不显示。
             因此显式关闭 Impeller，强制走 Skia + GLES 路径。
             key 名经 strings libflutter.so 验证，3.47.8 引擎仍识别 EnableImpeller。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
