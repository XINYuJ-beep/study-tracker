{
  "module": "01",
  "week_titles": {
    "1": "计算机组成 / 操作系统 / 命令行 / 文件系统"
  },
  "items": {
    "w1d1": {
      "form": "B",
      "points": [
        {"id": "w1d1-p1", "topic": "计算机五大组成部件", "desc": "运算器、控制器、存储器、输入设备、输出设备；运算器+控制器=CPU", "level": 1},
        {"id": "w1d1-p2", "topic": "二进制与进制换算", "desc": "二进制/八进制/十进制/十六进制互转；2的幂与位权；1字节=8位", "level": 1},
        {"id": "w1d1-p3", "topic": "CPU执行程序的基本流程", "desc": "取指-译码-执行-写回循环；指令存在内存、由PC指向", "level": 2},
        {"id": "w1d1-p4", "topic": "内存与硬盘的区别", "desc": "内存易失、快、断电丢数据；硬盘非易失、慢、容量大；程序必须先载入内存才能运行", "level": 1},
        {"id": "w1d1-p5", "topic": "十进制转二进制的除2取余法", "desc": "不断除2记录余数、倒序读出；验证例：45 -> 101101", "level": 2},
        {"id": "w1d1-p6", "topic": "计算机性能核心指标", "desc": "主频、核心数、内存容量、硬盘类型（HDD/SSD）；配置清单读法", "level": 1}
      ]
    },
    "w1d2": {
      "form": "B",
      "points": [
        {"id": "w1d2-p1", "topic": "操作系统四大功能", "desc": "进程管理、内存管理、文件管理、设备管理（含用户接口）", "level": 1},
        {"id": "w1d2-p2", "topic": "进程与程序的区别", "desc": "程序是静态文件，进程是运行中的实例；一个程序可对应多个进程", "level": 1},
        {"id": "w1d2-p3", "topic": "操作系统的作用与位置", "desc": "介于硬件与应用之间的资源管理者与抽象层", "level": 1},
        {"id": "w1d2-p4", "topic": "内核态与用户态", "desc": "特权指令只能内核态执行；系统调用是用户态进入内核态的唯一正规入口", "level": 3},
        {"id": "w1d2-p5", "topic": "进程的三种基本状态", "desc": "就绪、运行、阻塞；状态转换条件与不可逆路径", "level": 3},
        {"id": "w1d2-p6", "topic": "任务管理器中的进程/服务/启动项", "desc": "进程看资源占用，服务是后台常驻程序，启动项决定开机自启", "level": 1}
      ]
    },
    "w1d3": {
      "form": "A",
      "points": [
        {"id": "w1d3-p1", "topic": "pwd/ls/cd 三件套", "desc": "pwd打印当前路径；ls列目录（-l -a -h）；cd切换（.. 上级、~ 家目录、- 上次目录）", "level": 1},
        {"id": "w1d3-p2", "topic": "mkdir/cp/mv/rm", "desc": "mkdir -p递归建目录；cp -r递归复制；mv可移动也可改名；rm -rf不可恢复", "level": 1},
        {"id": "w1d3-p3", "topic": "绝对路径与相对路径", "desc": "以/开头为绝对；. 当前目录、.. 上级目录；相对路径依赖当前工作目录", "level": 1},
        {"id": "w1d3-p4", "topic": "Linux一切皆文件", "desc": "设备、管道、套接字都以文件形式暴露；统一用文件描述符操作", "level": 2},
        {"id": "w1d3-p5", "topic": "WSL2 的作用", "desc": "在Windows上跑真实Linux内核的轻量虚拟机，可共用文件系统与网络", "level": 1},
        {"id": "w1d3-p6", "topic": "rm 的危险性与防误删", "desc": "命令行删除不进回收站；误删不可逆；先ls确认再rm", "level": 2}
      ]
    },
    "w1d4": {
      "form": "A",
      "points": [
        {"id": "w1d4-p1", "topic": "Linux目录结构FHS", "desc": "/etc配置 /var可变数据 /home用户 /usr程序 /tmp临时 /bin命令 /root超管家目录", "level": 2},
        {"id": "w1d4-p2", "topic": "权限rwx与chmod数字法", "desc": "rwx=421；755=属主rwx组r-x其他r-x；chmod 755 file", "level": 2},
        {"id": "w1d4-p3", "topic": "文件属主与属组", "desc": "chown改属主、chgrp改属组；权限分属主/属组/其他三档", "level": 2},
        {"id": "w1d4-p4", "topic": "软链接ln -s", "desc": "类似快捷方式；删原文件则链接失效（悬空）；与硬链接的区别", "level": 3},
        {"id": "w1d4-p5", "topic": "tar打包与解包", "desc": "tar -czvf 打包压缩、tar -xzvf 解压；tar只打包不压缩，配合gzip才有压缩", "level": 2},
        {"id": "w1d4-p6", "topic": "目录树与tree命令", "desc": "目录树是层级结构，/为根；tree可以可视化展示层级", "level": 1}
      ]
    },
    "w1d5": {
      "form": "A",
      "points": [
        {"id": "w1d5-p1", "topic": "ps 查看进程", "desc": "ps aux 列出全部进程；STAT列状态；PID是进程唯一标识", "level": 2},
        {"id": "w1d5-p2", "topic": "top 实时监控", "desc": "按CPU/内存排序看负载；load average 三个值含义；q退出", "level": 2},
        {"id": "w1d5-p3", "topic": "kill 与信号", "desc": "kill -9 强制杀；SIGTERM(15)可被捕获做清理，SIGKILL(9)不可捕获", "level": 3},
        {"id": "w1d5-p4", "topic": "前台与后台运行", "desc": "命令后加& 放后台；Ctrl+Z挂起、bg转后台、fg调前台；jobs查看", "level": 2},
        {"id": "w1d5-p5", "topic": "进程占用过高如何排查", "desc": "top找PID -> ps -ef查来源 -> 看日志/依赖 -> kill或重启；排查顺序", "level": 3},
        {"id": "w1d5-p6", "topic": "父子进程与僵尸进程", "desc": "父进程fork出子进程；子退出父未回收即僵尸，占用PID表项", "level": 3}
      ]
    },
    "w1d6": {
      "form": "A",
      "points": [
        {"id": "w1d6-p1", "topic": "git init/add/commit/log 四步", "desc": "init初始化仓库；add加入暂存区；commit提交到本地历史；log查看提交记录", "level": 1},
        {"id": "w1d6-p2", "topic": "工作区/暂存区/本地仓库三区", "desc": "工作区改动 -> add -> 暂存区 -> commit -> 本地仓库；理解三区是关键", "level": 2},
        {"id": "w1d6-p3", "topic": "git remote 与 push", "desc": "remote add origin 绑定远程；push -u origin main 推首次并建立跟踪", "level": 2},
        {"id": "w1d6-p4", "topic": "Git 为什么是版本控制", "desc": "记录每次快照，可回退、可对比、可多人协作；分布式每份都是完整仓库", "level": 1},
        {"id": "w1d6-p5", "topic": "git status 与 diff", "desc": "status看改动状态；diff看具体改了什么；提交前必看", "level": 2},
        {"id": "w1d6-p6", "topic": "gitignore 的作用", "desc": "忽略不需版本管的文件（编译产物、密钥、缓存），提交前配置", "level": 2}
      ]
    },
    "w1d7": {
      "form": "C",
      "points": [
        {"id": "w1d7-p1", "topic": "本周命令综合回忆", "desc": "pwd/ls/cd/mkdir/cp/mv/rm/chmod/ln/tar/ps/top/kill/git 系列闭卷默写", "level": 2},
        {"id": "w1d7-p2", "topic": "组成+OS导图结构", "desc": "硬件五大件 -> OS四大功能 -> 进程/内存/文件/设备的对应关系", "level": 2},
        {"id": "w1d7-p3", "topic": "程序从点击到运行的链路", "desc": "从磁盘读入内存 -> OS创建进程 -> CPU取指执行 -> 输出到设备", "level": 3},
        {"id": "w1d7-p4", "topic": "命令的组合使用", "desc": "管道|把前一命令输出给后一命令；重定向>覆盖 >>追加", "level": 3},
        {"id": "w1d7-p5", "topic": "主动回忆式复习", "desc": "闭卷默写比重复阅读有效；Anki间隔重复对抗遗忘曲线", "level": 1},
        {"id": "w1d7-p6", "topic": "本周知识的前后关系", "desc": "通识打底 -> OS抽象 -> 命令行操作 -> Git留痕，后续Python与Web都建立在此之上", "level": 2}
      ]
    }
  }
}
